---
import Layout from '../layouts/Layout.astro';
import { getAllMeetings } from '../utils/getMeetings.js';

const meetings = getAllMeetings();

const allYears = [...new Set(meetings.map(m => m.year).filter(Boolean))].sort((a, b) => b - a);

const decadesObj = {};
meetings.forEach(m => {
  // Ensure we have a year
  if (!m.year && m.date) {
    m.year = new Date(m.date).getUTCFullYear();
  }
  
  // Ensure we have a decade
  if (!m.decade && m.year) {
    m.decade = Math.floor(m.year / 10) * 10 + 's';
  }

  if (m.decade && m.year) {
    if (!decadesObj[m.decade]) decadesObj[m.decade] = new Set();
    decadesObj[m.decade].add(m.year);
  }
});
const decades = Object.keys(decadesObj).sort((a, b) => parseInt(b) - parseInt(a)).map(d => ({
  decade: d,
  years: [...decadesObj[d]].sort((a, b) => b - a)
}));
---

<Layout title="Meeting Archives">
  <div style="margin-bottom: 3rem; text-align: center;">
    <h2 style="font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 700; color: var(--color-primary-dark); margin-bottom: 1rem;">
      Meeting Archives
    </h2>
    <p style="color: var(--color-text-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto;">
      Browse historical and recent Austin City Council meetings, complete with AI-generated summaries and full transcripts.
    </p>
  </div>

  <div class="layout-with-sidebar">
    <aside class="sidebar-container">
      <div class="glass-card sidebar-card">
        <details class="sidebar-details" id="sidebar-details">
          <summary class="sidebar-main-summary">
            <h3 class="sidebar-header">Browse by Decade</h3>
            <span class="main-toggle-icon">⌄</span>
          </summary>
          <div class="sidebar-content">
            <button class="all-meetings-btn active" data-reset-filter>All Meetings</button>
            
            {decades.map(d => (
              <details class="decade-details" data-decade-group={d.decade}>
                <summary class="decade-summary">
                  {d.decade}
                </summary>
                <ul class="year-list">
                  {d.years.map(y => (
                    <li class="year-item">
                      <button class="year-btn" data-filter-year={y}>{y}</button>
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </div>
        </details>
      </div>
    </aside>

    <div class="content-area">
      <div class="search-toolbar">
        <div class="search-input-wrapper">
          <span class="search-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </span>
          <input type="text" id="meeting-search" class="search-input" placeholder="Search meetings..." />
        </div>
        <select id="year-select" class="year-select">
          <option value="all">All Years</option>
          {allYears.map(y => (
            <option value={y}>{y}</option>
          ))}
        </select>
      </div>

      <div class="results-count">
        <span class="records-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
        </span>
        <span id="results-text">{meetings.length} records found</span>
      </div>

      <div id="meetings-grid" style="display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));">
        {meetings.length > 0 ? (
          meetings.map((meeting) => {
            const formattedDate = new Date(meeting.date).toLocaleDateString('en-US', {
              timeZone: 'UTC',
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            });

            const rawSearchText = `${meeting.title || ''} ${meeting.summary || ''} ${meeting.meeting_type || ''} ${formattedDate}`.toLowerCase();
            const searchText = rawSearchText.replace(/"/g, '&quot;');

            const summaryPattern = /^Here's.*?meeting.*?:\s*/is;
            const cleanSummary = meeting.summary
              ? meeting.summary.replace(summaryPattern, '').replace(/[#*]/g, '').substring(0, 150) + '...'
              : 'No summary available.';

            return (
              <a href={`/archives/meeting/${meeting.meeting_id}`} class="glass-card meeting-card" target="_blank" rel="noopener noreferrer" data-year={meeting.year} data-decade={meeting.decade} data-search={searchText} style="display: flex; flex-direction: column; text-decoration: none; color: inherit; padding: 1.5rem;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
                  <span style="font-size: 1rem; font-weight: 600; color: var(--color-primary-base); line-height: 1.3; flex: 1; min-width: 0;">
                    {meeting.title.length > 65 ? meeting.title.slice(0, 65) + '…' : meeting.title}
                  </span>
                  <span class="badge" style="font-size: 0.75rem; flex-shrink: 0;">{meeting.meeting_type}</span>
                </div>
                <span style="font-size: 0.75rem; font-weight: 500; color: black; margin-bottom: 0.85rem;">{formattedDate}</span>
                <p data-summary style="font-size: 0.9rem; color: var(--color-text-muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin-top: auto;">
                  {cleanSummary}
                </p>
              </a>
            );
          })
        ) : (
          <p style="grid-column: 1 / -1; text-align: center; color: var(--color-text-muted); padding: 3rem; background: var(--color-bg-surface); border-radius: var(--radius-md);">
            No meetings found in the archives.
          </p>
        )}
      </div>
    </div>
  </div>

  <script is:inline>
    function initArchiveSearch() {
      const searchInput = document.getElementById('meeting-search');
      const yearSelect = document.getElementById('year-select');
      const resetBtn = document.querySelector('[data-reset-filter]');
      const yearBtns = document.querySelectorAll('[data-filter-year]');
      const resultsText = document.getElementById('results-text');
      const grid = document.getElementById('meetings-grid');
      const sidebarDetails = document.getElementById('sidebar-details');

      if (sidebarDetails && window.innerWidth >= 768) sidebarDetails.open = true;
      if (!searchInput || !grid) return;
      if (searchInput.dataset.initialized) return;
      searchInput.dataset.initialized = 'true';

      // ── Collect all card data from DOM, then remove cards from DOM ──
      const allCards = Array.from(document.querySelectorAll('.meeting-card'));
      const cardData = allCards.map(card => ({
        el: card,
        year: card.getAttribute('data-year') || '',
        searchText: card.getAttribute('data-search') || '',
        summaryEl: card.querySelector('[data-summary]'),
        originalSummary: card.querySelector('[data-summary]')?.innerHTML || '',
      }));

      // Remove all cards from DOM — we'll re-insert as needed
      allCards.forEach(c => c.remove());

      let currentSearch = '';
      let currentYear = 'all';
      let debounceTimer;
      let renderTimer;

      const INITIAL_BATCH = 10;
      const LAZY_BATCH = 40;

      // ── Filter logic ──
      function getFilteredCards() {
        return cardData.filter(({ year, searchText }) => {
          const matchYear = currentYear === 'all' || year === currentYear;
          const matchSearch = currentSearch === '' || searchText.includes(currentSearch);
          return matchYear && matchSearch;
        });
      }

      // ── Snippet builder ──
      function buildSnippet(searchText, query) {
        if (!query) return null;

        const words = searchText.split(/\s+/);
        
        // Find the first word that contains the query
        const matchWordIdx = words.findIndex(w => w.includes(query));
        if (matchWordIdx === -1) return null;

        const start = Math.max(0, matchWordIdx - 10);
        const end = Math.min(words.length, matchWordIdx + 11);
        const before = words.slice(start, matchWordIdx).join(' ');
        const matchWord = words[matchWordIdx];
        const after = words.slice(matchWordIdx + 1, end).join(' ');

        return `${start > 0 ? '…' : ''}${before} <strong>${matchWord}</strong> ${after}${end < words.length ? '…' : ''}`;
      }

      // ── Render a batch of cards into the grid ──
      function renderCards(filtered, startIdx, count) {
        const frag = document.createDocumentFragment();
        const slice = filtered.slice(startIdx, startIdx + count);

        slice.forEach(({ el, summaryEl, originalSummary, searchText }) => {
          // Restore or replace summary
          if (summaryEl) {
            if (currentSearch) {
              const snippet = buildSnippet(searchText, currentSearch);
              summaryEl.innerHTML = snippet || originalSummary;
            } else {
              summaryEl.innerHTML = originalSummary;
            }
          }
          el.style.display = 'flex';
          frag.appendChild(el);
        });

        grid.appendChild(frag);
      }

      // ── Main render: clear grid, show first batch, lazy-load rest ──
      function renderAll() {
        // Clear grid
        while (grid.firstChild) grid.removeChild(grid.firstChild);

        const filtered = getFilteredCards();
        const total = filtered.length;

        if (resultsText) {
          resultsText.textContent = `${total} record${total !== 1 ? 's' : ''} found`;
        }

        if (total === 0) {
          grid.innerHTML = `<p style="grid-column:1/-1;text-align:center;color:var(--color-text-muted);padding:3rem;background:var(--color-bg-surface);border-radius:var(--radius-md);">No meetings found.</p>`;
          return;
        }

        // Render first 10 immediately
        renderCards(filtered, 0, INITIAL_BATCH);

        // Lazy-load the rest after a short delay so first paint is fast
        if (total > INITIAL_BATCH) {
          clearTimeout(renderTimer);
          renderTimer = setTimeout(() => {
            for (let i = INITIAL_BATCH; i < total; i += LAZY_BATCH) {
              renderCards(filtered, i, LAZY_BATCH);
            }
          }, 200);
        }

        // Sync UI controls
        if (yearSelect) yearSelect.value = currentYear;
        yearBtns.forEach(btn => {
          const isActive = btn.getAttribute('data-filter-year') === currentYear;
          btn.classList.toggle('active', isActive);
          if (isActive) btn.closest('details')?.setAttribute('open', '');
        });
        if (resetBtn) {
          resetBtn.classList.toggle('active', currentYear === 'all' && currentSearch === '');
        }
      }

      // ── Event listeners ──
      searchInput.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          currentSearch = e.target.value.toLowerCase().trim();
          renderAll();
        }, 300);
      });

      yearSelect?.addEventListener('change', (e) => {
        currentYear = e.target.value;
        renderAll();
      });

      resetBtn?.addEventListener('click', () => {
        currentSearch = '';
        currentYear = 'all';
        searchInput.value = '';
        renderAll();
      });

      yearBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          currentYear = e.target.getAttribute('data-filter-year');
          renderAll();
        });
      });

      // Initial render
      renderAll();
    }

    initArchiveSearch();
    document.addEventListener('astro:page-load', initArchiveSearch);
  </script>
</Layout>

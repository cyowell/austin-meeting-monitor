---
import Layout from '../layouts/Layout.astro';
import { getAllMeetings } from '../utils/getMeetings.js';

const meetings = getAllMeetings();

const allYears = [...new Set(meetings.map(m => m.year).filter(Boolean))].sort((a, b) => b - a);

const decadesObj = {};
meetings.forEach(m => {
  // Ensure we have a year
  if (!m.year && m.date) {
    m.year = new Date(m.date).getUTCFullYear();
  }
  
  // Ensure we have a decade
  if (!m.decade && m.year) {
    m.decade = Math.floor(m.year / 10) * 10 + 's';
  }

  if (m.decade && m.year) {
    if (!decadesObj[m.decade]) decadesObj[m.decade] = new Set();
    decadesObj[m.decade].add(m.year);
  }
});
const decades = Object.keys(decadesObj).sort((a, b) => parseInt(b) - parseInt(a)).map(d => ({
  decade: d,
  years: [...decadesObj[d]].sort((a, b) => b - a)
}));
---

<Layout title="Meeting Archives">


  <div class="layout-with-sidebar">
    <aside class="sidebar-container">
      <div class="glass-card sidebar-card">
        <details class="sidebar-details" id="sidebar-details">
          <summary class="sidebar-main-summary">
            <h3 class="sidebar-header">Browse by Decade</h3>
            <span class="main-toggle-icon">⌄</span>
          </summary>
          <div class="sidebar-content">
            <button class="all-meetings-btn active" data-reset-filter>All Meetings</button>
            
            {decades.map(d => (
              <details class="decade-details" data-decade-group={d.decade}>
                <summary class="decade-summary">
                  {d.decade}
                </summary>
                <ul class="year-list">
                  {d.years.map(y => (
                    <li class="year-item">
                      <button class="year-btn" data-filter-year={y}>{y}</button>
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </div>
        </details>
      </div>
    </aside>

    <div class="content-area">
      <div class="search-toolbar">
        <div class="search-input-wrapper">
          <span class="search-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </span>
          <input type="text" id="meeting-search" class="search-input" placeholder="Search meetings..." aria-label="Search meetings" />
        </div>
        <select id="year-select" class="year-select" aria-label="Filter by year">
          <option value="all">All Years</option>
          {allYears.map(y => (
            <option value={y}>{y}</option>
          ))}
        </select>
      </div>

      <div class="results-count">
        <span class="records-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
        </span>
        <span id="results-text">{meetings.length} records found</span>
      </div>

      <div id="meetings-grid" style="display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));">
        {/* We only render the first 15 meetings on the server to prevent massive HTML bloat.
            The client-side script will fetch the rest via the API and render them dynamically. */}
        {meetings.length > 0 ? (
          meetings.slice(0, 15).map((meeting) => {
            const formattedDate = new Date(meeting.date).toLocaleDateString('en-US', {
              timeZone: 'UTC',
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            });

            const summaryPattern = /^Here's.*?meeting.*?:\s*/is;
            const cleanSummary = meeting.summary
              ? meeting.summary.replace(summaryPattern, '').replace(/[#*]/g, '').substring(0, 150) + '...'
              : 'No summary available.';

            return (
              <a href={`/archives/meeting/${meeting.meeting_id}`} class="glass-card meeting-card" target="_blank" rel="noopener noreferrer" style="display: flex; flex-direction: column; text-decoration: none; color: inherit; padding: 1.5rem;">
                <span style="font-size: 1rem; font-weight: 600; color: var(--color-primary-base); line-height: 1.3; margin-bottom: 0.5rem; display: block;">
                  {meeting.title.length > 65 ? meeting.title.slice(0, 65) + '…' : meeting.title}
                </span>
                <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.85rem;">
                  <span class="badge" style="font-size: 0.75rem;" title={meeting.meeting_type}>
                    {meeting.meeting_type && meeting.meeting_type.length > 30 ? meeting.meeting_type.slice(0, 30) + '…' : meeting.meeting_type}
                  </span>
                  <span style="font-size: 0.75rem; font-weight: 500; color: black;">{formattedDate}</span>
                </div>
                <p data-summary style="font-size: 0.9rem; color: var(--color-text-muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin-top: auto;">
                  {cleanSummary}
                </p>
              </a>
            );
          })
        ) : (
          <p style="grid-column: 1 / -1; text-align: center; color: var(--color-text-muted); padding: 3rem; background: var(--color-bg-surface); border-radius: var(--radius-md);">
            No meetings found in the archives.
          </p>
        )}
      </div>
      
      <div id="loading-spinner" style="display: none; text-align: center; padding: 2rem; color: var(--color-text-muted);">
        Loading historical archives...
      </div>

      <div style="text-align: center; margin-top: 2rem; margin-bottom: 3rem;">
        <button id="load-more-btn" class="glass-btn" style="display: none; padding: 0.8rem 2rem; font-weight: 600; cursor: pointer; border-radius: var(--radius-full); background: var(--color-primary-light); color: var(--color-primary-dark); border: 1px solid rgba(0,0,0,0.1); transition: all 0.2s ease;">
          Load More
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    async function initArchiveSearch() {
      const searchInput = document.getElementById('meeting-search');
      const yearSelect = document.getElementById('year-select');
      const resetBtn = document.querySelector('[data-reset-filter]');
      const yearBtns = document.querySelectorAll('[data-filter-year]');
      const resultsText = document.getElementById('results-text');
      const grid = document.getElementById('meetings-grid');
      const sidebarDetails = document.getElementById('sidebar-details');
      const loadingSpinner = document.getElementById('loading-spinner');
      const loadMoreBtn = document.getElementById('load-more-btn');

      if (sidebarDetails && window.innerWidth >= 768) sidebarDetails.open = true;
      if (!searchInput || !grid) return;
      if (searchInput.dataset.initialized) return;
      searchInput.dataset.initialized = 'true';

      let currentSearch = '';
      let currentYear = 'all';
      let debounceTimer;
      
      const INITIAL_BATCH = 15;
      const LAZY_BATCH = 30;
      let allMeetingData = [];
      let isDataLoaded = false;
      let currentRenderIndex = 0;
      let currentFilteredData = [];

      // ── Fetch JSON API ──
      try {
        if (loadingSpinner && !isDataLoaded) loadingSpinner.style.display = 'block';
        
        const response = await fetch('/archives/api/meetings.json');
        if (!response.ok) throw new Error('Failed to fetch meetings');
        
        const data = await response.json();
        
        // Add searchable text to each meeting object
        allMeetingData = data.map(m => {
          const rawSearchText = `${m.title || ''} ${m.rawSummary || ''} ${m.type || ''} ${m.formattedDate || ''}`.toLowerCase();
          m.searchText = rawSearchText;
          return m;
        });
        
        isDataLoaded = true;
        if (loadingSpinner) loadingSpinner.style.display = 'none';
        
        // Re-render since data is now loaded
        renderAll();
      } catch (err) {
        console.error("Error loading archive data:", err);
        if (loadingSpinner) {
          loadingSpinner.textContent = "Error loading archives. Please try refreshing.";
        }
      }

      // ── Filter logic ──
      function getFilteredMeetings() {
        if (!isDataLoaded) return [];
        return allMeetingData.filter(m => {
          const matchYear = currentYear === 'all' || m.year.toString() === currentYear.toString();
          const matchSearch = currentSearch === '' || m.searchText.includes(currentSearch);
          return matchYear && matchSearch;
        });
      }

      // ── Snippet builder ──
      function buildSnippet(rawSummary, query) {
        if (!query || !rawSummary) return null;

        const cleanSummary = rawSummary.replace(/^Here's.*?meeting.*?:\s*/is, '').replace(/[#*]/g, '');
        const words = cleanSummary.split(/\s+/);
        const lowerWords = cleanSummary.toLowerCase().split(/\s+/);
        
        const matchWordIdx = lowerWords.findIndex(w => w.includes(query));
        if (matchWordIdx === -1) return null;

        const start = Math.max(0, matchWordIdx - 10);
        const end = Math.min(words.length, matchWordIdx + 11);
        const before = words.slice(start, matchWordIdx).join(' ');
        const matchWord = words[matchWordIdx];
        const after = words.slice(matchWordIdx + 1, end).join(' ');

        return `${start > 0 ? '…' : ''}${before} <strong>${matchWord}</strong> ${after}${end < words.length ? '…' : ''}`;
      }

      // ── Render a batch of cards into the grid ──
      function renderCards(startIdx, count) {
        let html = '';
        const slice = currentFilteredData.slice(startIdx, startIdx + count);

        slice.forEach(m => {
          const snippet = currentSearch ? (buildSnippet(m.rawSummary, currentSearch) || m.summary) : m.summary;
          const displayTitle = m.title.length > 65 ? m.title.slice(0, 65) + '…' : m.title;
          const displayType = m.type && m.type.length > 30 ? m.type.slice(0, 30) + '…' : m.type;

          html += `
            <a href="/archives/meeting/${m.id}" class="glass-card meeting-card" target="_blank" rel="noopener noreferrer" style="display: flex; flex-direction: column; text-decoration: none; color: inherit; padding: 1.5rem;">
              <span style="font-size: 1rem; font-weight: 600; color: var(--color-primary-base); line-height: 1.3; margin-bottom: 0.5rem; display: block;">
                ${displayTitle}
              </span>
              <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.85rem;">
                <span class="badge" style="font-size: 0.75rem;" title="${m.type || ''}">
                  ${displayType}
                </span>
                <span style="font-size: 0.75rem; font-weight: 500; color: black;">${m.formattedDate}</span>
              </div>
              <p data-summary style="font-size: 0.9rem; color: var(--color-text-muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin-top: auto;">
                ${snippet}
              </p>
            </a>
          `;
        });
        
        // Append HTML to grid
        grid.insertAdjacentHTML('beforeend', html);
        currentRenderIndex += slice.length;

        // Toggle Load More Button
        if (loadMoreBtn) {
          loadMoreBtn.style.display = currentRenderIndex < currentFilteredData.length ? 'inline-block' : 'none';
        }
      }

      // ── Main render: clear grid, show first batch ──
      function renderAll() {
        if (!isDataLoaded) return;
        
        grid.innerHTML = ''; // Clear DOM
        currentRenderIndex = 0;
        currentFilteredData = getFilteredMeetings();
        const total = currentFilteredData.length;

        if (resultsText) {
          resultsText.textContent = `${total} record${total !== 1 ? 's' : ''} found`;
        }

        if (total === 0) {
          grid.innerHTML = `<p style="grid-column:1/-1;text-align:center;color:var(--color-text-muted);padding:3rem;background:var(--color-bg-surface);border-radius:var(--radius-md);">No meetings found.</p>`;
          if (loadMoreBtn) loadMoreBtn.style.display = 'none';
          return;
        }

        renderCards(0, INITIAL_BATCH);

        if (yearSelect) yearSelect.value = currentYear;
        yearBtns.forEach(btn => {
          const isActive = btn.getAttribute('data-filter-year') === currentYear.toString();
          btn.classList.toggle('active', isActive);
          if (isActive) btn.closest('details')?.setAttribute('open', '');
        });
        if (resetBtn) {
          resetBtn.classList.toggle('active', currentYear === 'all' && currentSearch === '');
        }
      }

      // ── Event listeners ──
      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', () => {
          renderCards(currentRenderIndex, LAZY_BATCH);
        });
      }
      searchInput.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          currentSearch = e.target.value.toLowerCase().trim();
          renderAll();
        }, 1000); // 1 second debounce for better mobile performance
      });

      yearSelect?.addEventListener('change', (e) => {
        currentYear = e.target.value;
        renderAll();
      });

      resetBtn?.addEventListener('click', () => {
        currentSearch = '';
        currentYear = 'all';
        searchInput.value = '';
        renderAll();
      });

      yearBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          currentYear = e.target.getAttribute('data-filter-year');
          renderAll();
        });
      });
    }

    initArchiveSearch();
    document.addEventListener('astro:page-load', initArchiveSearch);
  </script>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { getAllMeetings } from '../../utils/getMeetings.js';
import { marked } from 'marked';

export async function getStaticPaths() {
  const meetings = getAllMeetings();
  
  return meetings.map((meeting) => {
    // Generate a clean slug from the meeting ID
    const slug = meeting.meeting_id;
    return {
      params: { id: slug },
      props: { meeting },
    };
  });
}

const { meeting } = Astro.props;

// Convert markdown summary to HTML safely
const summaryHtml = meeting.summary ? marked.parse(meeting.summary) : '<p>No summary available.</p>';

// Formatting helpers
const formattedDate = new Date(meeting.date).toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={`${meeting.title || meeting.meeting_type}`}>
  <article class="glass-card">
    <header style="margin-bottom: 2rem; border-bottom: 1px solid rgba(0,0,0,0.1); padding-bottom: 1.5rem;">
      <div class="meeting-meta">
        <span class="badge">{meeting.meeting_type}</span>
        <span class="meeting-date">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -3px; margin-right: 4px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          {formattedDate}
        </span>
      </div>
      
      <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; line-height: 1.2; text-wrap: balance; margin-bottom: 1.5rem; color: var(--color-primary-dark);">
        {meeting.title || `${meeting.meeting_type} Meeting`}
      </h1>
      
      <div class="action-buttons">
        {meeting.agenda_url && (
          <a href={meeting.agenda_url} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
            View Agenda
          </a>
        )}
        {meeting.pdf_url && (
          <a href={meeting.pdf_url} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            Original PDF
          </a>
        )}
      </div>
    </header>

    <div class="prose" set:html={summaryHtml} />

    {meeting.transcript && (
      <div class="transcript-container">
        <h3 style="margin-top: 0; margin-bottom: 1rem; color: var(--color-primary-dark); position: sticky; top: -1.5rem; background: var(--color-bg-surface); padding-block: 1.5rem 0.5rem; z-index: 1;">
          Full Transcript
        </h3>
        <div class="transcript-content">
          {meeting.transcript}
        </div>
      </div>
    )}
  </article>
</Layout>

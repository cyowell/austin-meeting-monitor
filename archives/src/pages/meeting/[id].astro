---
import Layout from '../../layouts/Layout.astro';
import { getAllMeetings } from '../../utils/getMeetings.js';
import { marked } from 'marked';

export async function getStaticPaths() {
  const meetings = getAllMeetings();
  
  return meetings.map((meeting) => {
    // Generate a clean slug from the meeting ID
    const slug = meeting.meeting_id;
    return {
      params: { id: slug },
      props: { meeting },
    };
  });
}

const { meeting } = Astro.props;

// Formatting helpers
// Use timeZone: 'UTC' to ensure dates parsed as UTC midnight (like YYYY-MM-DD) don't shift backward
const formattedDate = new Date(meeting.date).toLocaleDateString('en-US', {
  timeZone: 'UTC',
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Format summary text by making the introductory boilerplate an H2
const boilerplateRegex = new RegExp("^Here's.*?meeting.*?:\\s*", "is");
let modifiedSummaryText = meeting.summary 
  ? meeting.summary.replace(boilerplateRegex, (match) => `## ${match.trim()}\n\n`) 
  : '';

// Pre-process bullet points to turn bold titles into H3
if (modifiedSummaryText) {
  // Convert bullet items starting with bold text to have an H3
  modifiedSummaryText = modifiedSummaryText.replace(/^[*-]\s+\*\*(.*?)\*\*[:\-]?\s*/gm, '* <h3>$1</h3> ');
}

// Clean summary text for SEO description
const cleanSummaryText = meeting.summary 
  ? meeting.summary.replace(boilerplateRegex, '') 
  : '';

// Convert markdown summary to HTML safely
const summaryHtml = modifiedSummaryText ? marked.parse(modifiedSummaryText) : '<p>No summary available.</p>';

// Extract a plain text description for SEO
const metaDescription = cleanSummaryText ? cleanSummaryText.replace(/[#*]/g, '').substring(0, 150) + '...' : 'Austin City Council Meeting Archive';

// Format transcript for mobile display (removes hard line breaks within paragraphs)
let formattedTranscript = meeting.transcript;
if (formattedTranscript) {
  formattedTranscript = formattedTranscript
    .replace(/\r\n/g, '\n')
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.replace(/\n/g, ' '))
    .join('\n\n');
}

// Define the page title, using the custom title if it exists (like for 1800s meetings)
const pageTitle = meeting.title ? `${meeting.title} - ${formattedDate}` : `${formattedDate} ${meeting.meeting_type}`;
---

<Layout title={pageTitle} description={metaDescription}>
  <div style="margin-bottom: 1.5rem;">
    <a href="/archives/" style="display: inline-flex; align-items: center; gap: 0.4rem; color: var(--color-primary-base); font-weight: 600; text-decoration: none; opacity: 0.85; transition: opacity 0.2s ease;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.85'">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5"></path><polyline points="12 19 5 12 12 5"></polyline></svg>
      Back to Archives
    </a>
  </div>
  <article class="glass-card">
    <header style="margin-bottom: 2rem; border-bottom: 1px solid rgba(0,0,0,0.1); padding-bottom: 1.5rem;">
      <div class="meeting-meta">
        <span class="meeting-date">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -3px; margin-right: 4px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          {formattedDate}
        </span>
        <span class="badge">{meeting.meeting_type}</span>
      </div>
      
      <div class="action-buttons">
        {meeting.meeting_url && (
          <a href={meeting.meeting_url} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
            Official City Record
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left: 4px; margin-right: -4px;"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </a>
        )}
        {meeting.agenda_url && (
          <a href={meeting.agenda_url} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
            Agenda
          </a>
        )}
        {meeting.actions_url && (
          <a href={meeting.actions_url} class="btn btn-actions" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
            Actions Taken
          </a>
        )}
        {meeting.video_url && (
          <a href={meeting.video_url} class="btn btn-video" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
            Watch Video
          </a>
        )}
        {meeting.pdf_url && (
          <a href={meeting.pdf_url} class="btn btn-transcript" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            Transcript
          </a>
        )}
      </div>
    </header>

    {meeting.title && (
      <h2 style="margin-top: 0; margin-bottom: 1.5rem; color: var(--color-primary-dark);">
        {meeting.title}
      </h2>
    )}

    <div class="prose" set:html={summaryHtml} />

    {formattedTranscript && (
      <div class="transcript-container">
        <h3 style="margin-top: 0; margin-bottom: 1rem; color: var(--color-primary-dark); position: sticky; top: -1.5rem; background: var(--color-bg-surface); padding-block: 1.5rem 0.5rem; z-index: 1;">
          Full Transcript
        </h3>
        <div class="transcript-content">
          {formattedTranscript}
        </div>
      </div>
    )}
  </article>
</Layout>
